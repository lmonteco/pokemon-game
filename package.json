{
  "name": "deepwild",
  "version": "0.0.0",
  "private": true,
  "description": "DEEPWILD - a free, non-commercial fan game. Original assets only.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate:data && tsc --noEmit && vite build",
    "preview": "vite preview",
    "validate:data": "node scripts/validate-data.ts",
    "test": "npm run validate:data && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "phaser": "^4.2.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
